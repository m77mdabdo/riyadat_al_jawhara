# -----------------------------------------------------------------------------
# Riyadat Al-Jawhara (JRA) — environment template
# Copy to .env and fill in. Never commit .env. Values below are placeholders
# for local development; see DEPLOY.md for the production values.
# -----------------------------------------------------------------------------

APP_NAME="Riyadat Al-Jawhara"
# local | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in production.
APP_DEBUG=true
# Keep UTC unless deliberately migrating: changing it shifts how existing
# timestamps are interpreted. Display-time conversion is a separate decision.
APP_TIMEZONE=UTC
# Must match the exact URL the site is served from (scheme + host, no trailing
# slash). Media Library builds image URLs from it.
APP_URL=http://localhost

# Default site language for first-time visitors (ar | en).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: LOG_STACK=daily, LOG_LEVEL=warning (see DEPLOY.md, log rotation).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riyadat_al_jawhara
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production (HTTPS only). Set explicitly to override.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Lead notification emails are queued: run a worker (php artisan queue:work)
# or set QUEUE_CONNECTION=sync to send them during the request.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: "log" writes emails to storage/logs. Production: smtp (or ses/postmark)
# so lead notifications and admin password-reset emails are actually sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Media Library disk (public = storage/app/public, served via storage:link).
MEDIA_DISK=public
IMAGE_DRIVER=gd

VITE_APP_NAME="${APP_NAME}"

# Stock-photo APIs — ONLY used by `php artisan fetch:stock-media` and the demo
# seeders. Leave empty in production; the site never calls them at runtime.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional, consent-gated analytics (config/analytics.php). Leave empty = off:
# no banner, no scripts, no CSP changes. Nothing loads before consent (PDPL).
ANALYTICS_GA4_ID=
ANALYTICS_PLAUSIBLE_DOMAIN=
ANALYTICS_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Days to keep IP address / user agent on comments and leads (privacy:prune, daily).
PRIVACY_RETENTION_DAYS=180
